# pyRealEstate .gitignore
#
# This repository holds only the library: the package source, pyproject.toml,
# README, LICENSE, and the PyPI publish workflow. Everything ignored below is
# generated by Python, build tools, test runners, editors, or the operating
# system, and can always be recreated.
#
# Note: this file only affects git. What ships to PyPI is controlled by
# pyproject.toml ([tool.setuptools] packages).


# --- Python bytecode ----------------------------------------------------------
__pycache__/
*.py[cod]


# --- Build and packaging output (uv build, pip install -e .) -------------------
build/
dist/
*.egg-info/
.eggs/
*.egg


# --- Virtual environments and local settings ----------------------------------
.venv/
venv/
env/
# .env files may hold secrets such as a PyPI token; never commit them.
.env


# --- Test, coverage, and linter caches ----------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/


# --- Jupyter notebooks ---------------------------------------------------------
.ipynb_checkpoints/


# --- Editors and operating systems --------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
